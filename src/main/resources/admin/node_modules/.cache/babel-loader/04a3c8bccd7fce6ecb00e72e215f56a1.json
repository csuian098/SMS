{"remainingRequest":"F:\\springboot32e20828n(2)\\springboot32e20828n\\src\\main\\resources\\admin\\node_modules\\babel-loader\\lib\\index.js!F:\\springboot32e20828n(2)\\springboot32e20828n\\src\\main\\resources\\admin\\src\\utils\\validate.js","dependencies":[{"path":"F:\\springboot32e20828n(2)\\springboot32e20828n\\src\\main\\resources\\admin\\src\\utils\\validate.js","mtime":1775382678000},{"path":"F:\\springboot32e20828n(2)\\springboot32e20828n\\src\\main\\resources\\admin\\node_modules\\cache-loader\\dist\\cjs.js","mtime":499162500000},{"path":"F:\\springboot32e20828n(2)\\springboot32e20828n\\src\\main\\resources\\admin\\node_modules\\babel-loader\\lib\\index.js","mtime":499162500000}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["F:/springboot32e20828n(2)/springboot32e20828n/src/main/resources/admin/src/utils/validate.js"],"names":["isEmail","s","test","isMobile","isPhone","isURL","isNumber","isIntNumer","checkIdCard","idcard","regIdCard","isChinese","isEnglish","isEnglishNumber"],"mappings":"AAAA;;;;AAIA,OAAO,SAASA,OAAT,CAAiBC,CAAjB,EAAoB;AAC1B,SAAO,kEAAkEC,IAAlE,CAAuED,CAAvE,CAAP;AACA;AAED;;;;;AAIA,OAAO,SAASE,QAAT,CAAkBF,CAAlB,EAAqB;AAC3B,SAAO,qBAAqBC,IAArB,CAA0BD,CAA1B,CAAP;AACA;AAED;;;;;AAIA,OAAO,SAASG,OAAT,CAAiBH,CAAjB,EAAoB;AAC1B,SAAO,6BAA6BC,IAA7B,CAAkCD,CAAlC,CAAP;AACA;AAED;;;;;AAIA,OAAO,SAASI,KAAT,CAAeJ,CAAf,EAAkB;AACxB,SAAO,mBAAmBC,IAAnB,CAAwBD,CAAxB,CAAP;AACA;AAED;;;;;AAIA,OAAO,SAASK,QAAT,CAAkBL,CAAlB,EAAqB;AAC3B,SAAO,sEAAsEC,IAAtE,CAA2ED,CAA3E,CAAP;AACA;AACD;;;;;AAIA,OAAO,SAASM,UAAT,CAAoBN,CAApB,EAAuB;AAC7B,SAAO,iBAAiBC,IAAjB,CAAsBD,CAAtB,CAAP;AACA;AACD;;;;AAGA,OAAO,SAASO,WAAT,CAAqBC,MAArB,EAA6B;AACnC,MAAMC,SAAS,GAAG,0FAAlB;;AACA,MAAI,CAACA,SAAS,CAACR,IAAV,CAAeO,MAAf,CAAL,EAA6B;AAC5B,WAAO,KAAP;AACA,GAFD,MAEO;AACN,WAAO,IAAP;AACA;AACD;AACD;;;;;AAIA,OAAO,SAASE,SAAT,CAAmBV,CAAnB,EAAsB;AAC5B,SAAO,qBAAqBC,IAArB,CAA0BD,CAA1B,CAAP;AACA;AACD;;;;;AAIA,OAAO,SAASW,SAAT,CAAmBX,CAAnB,EAAsB;AAC5B,SAAO,cAAcC,IAAd,CAAmBD,CAAnB,CAAP;AACA;AACD;;;;;AAIA,OAAO,SAASY,eAAT,CAAyBZ,CAAzB,EAA4B;AAClC,SAAO,iBAAiBC,IAAjB,CAAsBD,CAAtB,KAA0B,6BAA6BC,IAA7B,CAAkCD,CAAlC,CAAjC;AACA","sourcesContent":["/**\r\n * 邮箱\r\n * @param {*} s\r\n */\r\nexport function isEmail(s) {\r\n\treturn /^([a-zA-Z0-9_-])+@([a-zA-Z0-9_-])+((.[a-zA-Z0-9_-]{2,3}){1,2})$/.test(s)\r\n}\r\n\r\n/**\r\n * 手机号码\r\n * @param {*} s\r\n */\r\nexport function isMobile(s) {\r\n\treturn /^1[23456789]\\d{9}$/.test(s)\r\n}\r\n\r\n/**\r\n * 电话号码\r\n * @param {*} s\r\n */\r\nexport function isPhone(s) {\r\n\treturn /^([0-9]{3,4}-)?[0-9]{7,8}$/.test(s)\r\n}\r\n\r\n/**\r\n * URL地址\r\n * @param {*} s\r\n */\r\nexport function isURL(s) {\r\n\treturn /^http[s]?:\\/\\/.*/.test(s)\r\n}\r\n\r\n/**\r\n * 匹配数字，可以是小数，不可以是负数,可以为空\r\n * @param {*} s \r\n */\r\nexport function isNumber(s) {\r\n\treturn /(^-?[+-]?([0-9]*\\.?[0-9]+|[0-9]+\\.?[0-9]*)([eE][+-]?[0-9]+)?$)|(^$)/.test(s);\r\n}\r\n/**\r\n * 匹配整数，可以为空\r\n * @param {*} s \r\n */\r\nexport function isIntNumer(s) {\r\n\treturn /(^-?\\d+$)|(^$)/.test(s);\r\n}\r\n/**\r\n * 身份证校验\r\n */\r\nexport function checkIdCard(idcard) {\r\n\tconst regIdCard = /^[1-9]\\d{5}(18|19|20)\\d{2}((0[1-9])|(10|11|12))((0[1-9])|([1-2][0-9])|30|31)\\d{3}[\\dXx]$/;\r\n\tif (!regIdCard.test(idcard)) {\r\n\t\treturn false;\r\n\t} else {\r\n\t\treturn true;\r\n\t}\r\n}\r\n/**\r\n * 匹配中文，可以为空\r\n * @param {*} s \r\n */\r\nexport function isChinese(s) {\r\n\treturn /^[\\u4e00-\\u9fa5]+$/.test(s);\r\n}\r\n/**\r\n * 匹配英文，可以为空\r\n * @param {*} s \r\n */\r\nexport function isEnglish(s) {\r\n\treturn /^[A-Za-z]+$/.test(s);\r\n}\r\n/**\r\n * 匹配英文和数字，可以为空\r\n * @param {*} s \r\n */\r\nexport function isEnglishNumber(s) {\r\n\treturn /^[A-Za-z0-9]+$/.test(s)&&/^(?=.*\\d)(?=.*[a-zA-Z]).+$/.test(s);\r\n}"]}]}