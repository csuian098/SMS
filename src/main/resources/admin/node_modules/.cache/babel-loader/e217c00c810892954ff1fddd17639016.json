\t\t}))\r\n\t\t\t\t\t\t\twindow.URL.revokeObjectURL(data)\r\n\t\t\t\t\t\t\tmessage.message(\"数据备份成功\")\r\n\t\t\t\t\t\t} else {\r\n\t\t\t\t\t\t\tlet message = this.$message\r\n\t\t\t\t\t\t\tmessage.error(data.msg);\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t});\r\n\t\t\t\t});\r\n\t\t\t},\r\n\t\t}\r\n\t};\r\n</script>\r\n\r\n\r\n<style lang=\"scss\" scoped>\r\n\t.navbar {\r\n\t\t.title {\r\n\t\t\tmargin: 0;\r\n\t\t\tleft: 20%;\r\n\t\t\tdisplay: block;\r\n\t\t\twidth: 60%;\r\n\t\t\tposition: absolute;\r\n\t\t\ttext-align: center;\r\n\t\t\t.title-name {\r\n\t\t\t\tpadding: 0;\r\n\t\t\t\tcolor: #000;\r\n\t\t\t\tfont-weight: 600;\r\n\t\t\t\tfont-size: 32px;\r\n\t\t\t\tline-height: 44px;\r\n\t\t\t}\r\n\t\t}\r\n\t\t.dropdown-box {\r\n\t\t\tcolor: #666;\r\n\t\t\tdisplay: flex;\r\n\t\t\tfont-size: 16px;\r\n\t\t\torder: 11;\r\n\t\t\t.el-dropdown-link {\r\n\t\t\t\tdisplay: flex;\r\n\t\t\t\talign-items: center;\r\n\t\t\t\t.el-image {\r\n\t\t\t\t\tborder-radius: 100%;\r\n\t\t\t\t\tmargin: 0 10px;\r\n\t\t\t\t\tobject-fit: cover;\r\n\t\t\t\t\tdisplay: inline-block;\r\n\t\t\t\t\twidth: 42px;\r\n\t\t\t\t\theight: 42px;\r\n\t\t\t\t}\r\n\t\t\t\t.label {\r\n\t\t\t\t\tcolor: #666;\r\n\t\t\t\t\tfont-size: 16px;\r\n\t\t\t\t\tline-height: 32px;\r\n\t\t\t\t}\r\n\t\t\t\t.nickname {\r\n\t\t\t\t\tcolor: #666;\r\n\t\t\t\t\tfont-size: 16px;\r\n\t\t\t\t\tline-height: 32px;\r\n\t\t\t\t}\r\n\t\t\t\t.iconfont {\r\n\t\t\t\t\tmargin: 0 0 0 5px;\r\n\t\t\t\t\tcolor: #666;\r\n\t\t\t\t\tfont-size: 14px;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\t.top-el-dropdown-menu {\r\n\t\tborder: 1px solid #EBEEF5;\r\n\t\tborder-radius: 4px;\r\n\t\tpadding: 10px 0;\r\n\t\tbox-shadow: 0 2px 12px 0 rgba(0,0,0,.1);\r\n\t\tmargin: 18px 0;\r\n\t\tbackground: #FFF;\r\n\t\tli.el-dropdown-menu__item.item1 {\r\n\t\t\tcursor: pointer;\r\n\t\t\tpadding: 0 20px;\r\n\t\t\tmargin: 0;\r\n\t\t\toutline: 0;\r\n\t\t\tcolor: #606266;\r\n\t\t\tbackground: #fff;\r\n\t\t\tfont-size: 14px;\r\n\t\t\tline-height: 36px;\r\n\t\t\tlist-style: none;\r\n\t\t\